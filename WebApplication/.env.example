# WebApplication/.env.example -- template for the legacy Flask + PostgreSQL app.
# Copy to WebApplication/.env (which is gitignored) or export these as environment
# variables. The app loads them with python-dotenv (load_dotenv) then os.getenv(),
# so a real .env file is optional when the variables are already in the environment.
# Never commit a filled-in copy.

# PostgreSQL connection (read by HandleAccess.py, Classes/Doctor.py, Classes/Admin.py)
host=
database=
user=
password=
port=5432

# Directory where uploaded embryo image folders are stored (embryo_{ID}_{date}/)
EMBRYO_IMAGES_PATH=
