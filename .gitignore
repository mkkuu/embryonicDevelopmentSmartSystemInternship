# Ignore datasets
Data/

# Ignore cached embeddings (regenerable via Training/embeddings/build_cache.py)
Embeddings/

# Ignore model checkpoints
Models/

# Ignore training results/checkpoints (built directly on the remote GPU box)
Results/

# Ignore the Reporting API's disk-backed inference cache (regenerable via
# Training/reporting/, see docs/REPORTING_CACHE.md -- pure serving
# infrastructure, never a scientific artifact)
Cache/
RagIndex/
rag_benchmark_report.json

# Ignore Python cache
__pycache__/
*.pyc
.pytest_cache/

.vscode/

# docs/ is local-only by default (session logs, audits, historical reports),
# with two runtime exceptions a fresh clone genuinely cannot work without:
#
#   docs/corpus/  validator/corpus.py (DEFAULT_CORPUS_PATH) and
#                 orchestrator/scientific_reference.py read
#                 docs/corpus/ISTANBUL_CONSENSUS_2025.md at import time.
#   docs/*.md     the top-level documents rag/inventory.py classifies;
#                 rag/ingest.py builds the vector index from the 30 INCLUDED
#                 ones, so without them `python -m rag.ingest` cannot run.
#
# Written as `docs/*` rather than `docs/` because Git cannot re-include a path
# whose parent directory is excluded. The negations are deliberately narrow:
# `!docs/*.md` matches the TOP LEVEL only, so docs/archive/ (session logs,
# audits, historical reports) and docs/reference/ stay ignored -- no runtime
# code path reads either of them.
docs/*
!docs/corpus/
!docs/*.md

.claude/
CLAUDE.md
deploy2GPUServ.sha

# Graphify knowledge graph output (regenerable via `graphify .`; rebuilt
# automatically by the post-commit/post-checkout hooks)
graphify-out/

# Local secrets / environment files (never commit; see WebApplication/.env.example)
.env
*.env
!*.env.example
WebApplication/.env
