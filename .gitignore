# Ignore datasets
Data/

# Ignore cached embeddings (regenerable via Training/embeddings/build_cache.py)
Embeddings/

# Ignore model checkpoints
Models/

# Ignore training results/checkpoints (built directly on the remote GPU box)
Results/

# Ignore the Reporting API's disk-backed inference cache (regenerable via
# Training/reporting/, see docs/REPORTING_CACHE.md -- pure serving
# infrastructure, never a scientific artifact)
Cache/
RagIndex/
rag_benchmark_report.json

# Ignore Python cache
__pycache__/
*.pyc

.vscode/

# docs/ stays local-only (working notes, session logs, historical reports) with
# ONE exception: docs/corpus/ is a runtime dependency, not documentation.
# validator/corpus.py (DEFAULT_CORPUS_PATH) and orchestrator/scientific_reference.py
# read docs/corpus/ISTANBUL_CONSENSUS_2025.md at import time, so a fresh clone
# cannot run the Validator without it. Written as `docs/*` rather than `docs/`
# because Git cannot re-include a path whose parent directory is excluded.
# rag/inventory.py globs `docs/*.md` NON-recursively, so nothing here changes
# the RAG's 30-document set or the vector index identity.
docs/*
!docs/corpus/

.claude/
CLAUDE.md
deploy2GPUServ.sha

# Graphify knowledge graph output (regenerable via `graphify .`; rebuilt
# automatically by the post-commit/post-checkout hooks)
graphify-out/

# Local secrets / environment files (never commit; see WebApplication/.env.example)
.env
*.env
!*.env.example
WebApplication/.env
